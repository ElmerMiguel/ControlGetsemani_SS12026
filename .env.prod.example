# ==============================================================================
# Plantilla de Variables de Entorno de Producción — Iglesia Getsemaní
# Reglas: ARQUITECTURA_FASE3.md §6 | Prompt P21
# NUNCA ingresar valores reales o credenciales en este archivo versionado.
# ==============================================================================

# Configuración General de la Aplicación
APP_NAME="Iglesia Getsemaní - Finanzas e Inventario"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://controlgetse.12345611.xyz
ASSET_URL=https://controlgetse.12345611.xyz
APP_TIMEZONE=America/Guatemala
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Registro y Logs
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Base de Datos (MariaDB Oficial)
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=getsemani_prod
DB_USERNAME=getsemani_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO_EN_PRODUCCION
DB_ROOT_PASSWORD=CAMBIAR_POR_ROOT_PASSWORD_SEGURO

# Sesiones de Usuario y Seguridad (D3-05)
SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Colas de Trabajo y Caché (D3-04)
# En producción el worker supervisado procesa las tareas de colas (database)
QUEUE_CONNECTION=database
CACHE_STORE=database

# Almacenamiento de Archivos (Comprobantes de Donación)
FILESYSTEM_DISK=local

# Configuración de Correo Electrónico (Notificaciones y 2FA)
MAIL_MAILER=ses
MAIL_FROM_ADDRESS="no-reply@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (Para SSM Parameter Store y SES en EC2/VPS)
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=

# Credenciales Iniciales de Administrador (Sembrado Seguro Inicial)
ADMIN_NAME="Administrador General"
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=CAMBIAR_POR_CONTRASENA_COMPLEJA

# REGLA ESTRICTA: Prohibido sembrado de datos de prueba en producción
SEED_DEMO=false

# Configuración de Dominio y SSL para Nginx y Certbot
DOMAIN=localhost
REDIRECT_TO_HTTPS=false
CERTBOT_EMAIL=admin@tudominio.com
